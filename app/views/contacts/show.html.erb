<% content_for :title, "#{@contact.name} · DueCall" %>

<% if notice = flash[:notice] %>
  <p class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= notice %></p>
<% end %>

<div class="flex items-start justify-between gap-4">
  <div>
    <%= link_to "← #{@customer.name}", customer_path(@customer), class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950"><%= @contact.name %></h1>
    <% if @contact.role.present? %>
      <p class="mt-1 text-sm text-slate-500"><%= @contact.role %></p>
    <% end %>
  </div>
  <%= link_to "Edit", edit_contact_path(@contact), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
</div>

<dl class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="grid gap-1 border-b border-slate-200 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Phone number</dt>
    <dd class="text-sm text-slate-900 sm:col-span-2"><%= link_to @contact.phone_number, "tel:#{@contact.phone_number}", class: "font-medium text-blue-600 hover:text-blue-500" %></dd>
  </div>
  <div class="grid gap-1 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Email</dt>
    <dd class="text-sm text-slate-900 sm:col-span-2">
      <% if @contact.email.present? %>
        <%= mail_to @contact.email, @contact.email, class: "font-medium text-blue-600 hover:text-blue-500" %>
      <% else %>
        Not provided
      <% end %>
    </dd>
  </div>
</dl>

<div class="mt-8 border-t border-slate-200 pt-6">
  <%= button_to "Delete contact", @contact, method: :delete, class: "text-sm font-medium text-red-600 hover:text-red-500", form: { data: { turbo_confirm: "Delete this contact?" } } %>
</div>
