<% content_for :title, "Add contact · DueCall" %>

<div class="mx-auto max-w-xl">
  <%= link_to "← #{@customer.name}", customer_path(@customer), class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>
  <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Add contact</h1>
  <p class="mt-2 text-sm text-slate-500">Add someone you can reach at <%= @customer.name %>.</p>

  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", customer: @customer, contact: @contact %>
  </div>
</div>
