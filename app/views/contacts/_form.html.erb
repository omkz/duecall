<%= form_with model: (contact.persisted? ? contact : [ customer, contact ]), class: "space-y-6" do |form| %>
  <% if contact.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
  </div>

  <div>
    <%= form.label :role, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :role, placeholder: "Owner, Finance, Operations…", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
    <p class="mt-1.5 text-xs text-slate-500">Optional</p>
  </div>

  <div>
    <%= form.label :phone_number, class: "block text-sm font-medium text-slate-700" %>
    <%= form.telephone_field :phone_number, required: true, placeholder: "+628123456789", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
    <p class="mt-1.5 text-xs text-slate-500">Use international E.164 format, starting with + and the country code.</p>
  </div>

  <div>
    <%= form.label :email, class: "block text-sm font-medium text-slate-700" %>
    <%= form.email_field :email, placeholder: "contact@example.com", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
    <p class="mt-1.5 text-xs text-slate-500">Optional</p>
  </div>

  <div class="flex items-center gap-3 border-t border-slate-200 pt-6">
    <%= form.submit class: "cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
    <%= link_to "Cancel", contact.persisted? ? contact_path(contact) : customer_path(customer), class: "rounded-lg px-4 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-950" %>
  </div>
<% end %>
