<% content_for :title, "Call for #{@invoice.number} · DueCall" %>

<% if alert = flash[:alert] %>
  <p class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= alert %></p>
<% end %>

<% if notice = flash[:notice] %>
  <p class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= notice %></p>
<% end %>

<header>
  <%= link_to "← #{@invoice.number}", invoice_path(@invoice), class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>
  <div class="mt-3 flex flex-wrap items-center gap-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-950">Call with <%= @contact.name %></h1>
    <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= call_attempt_status_classes(@call_attempt) %>"><%= @call_attempt.status.humanize %></span>
  </div>
  <p class="mt-2 text-sm text-slate-500"><%= @customer.name %> · <%= @invoice.number %></p>
</header>

<% if @call_attempt.completed? %>
  <section class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-labelledby="call-result-heading">
    <div class="border-b border-slate-200 bg-slate-50 px-6 py-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">Call completed</p>
      <p class="mt-3 text-sm font-medium text-slate-500">Outcome</p>
      <h2 id="call-result-heading" class="mt-1 text-2xl font-bold tracking-tight text-slate-950"><%= @call_attempt.outcome&.humanize || "Unknown" %></h2>
    </div>
    <div class="space-y-5 px-6 py-5">
      <% if @call_attempt.reason.present? %>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Reason</p>
          <p class="mt-1 text-base font-medium leading-7 text-slate-900"><%= @call_attempt.reason %></p>
        </div>
      <% end %>

      <% if @call_attempt.summary.present? %>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Summary</p>
          <p class="mt-1 max-w-3xl text-base leading-7 text-slate-700"><%= @call_attempt.summary %></p>
        </div>
      <% end %>

      <% if @call_attempt.promised_to_pay? && @call_attempt.promise_to_pay_on.present? %>
        <% if payment_promise_missed?(@call_attempt, @invoice) %>
          <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Payment promise missed</p>
            <p class="mt-1 font-semibold text-amber-950"><%= @call_attempt.promise_to_pay_on.to_fs(:long) %></p>
          </div>
        <% else %>
          <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Promised payment</p>
            <p class="mt-1 font-semibold text-emerald-950"><%= @call_attempt.promise_to_pay_on.to_fs(:long) %></p>
          </div>
        <% end %>
      <% elsif @call_attempt.promise_to_pay_on.present? %>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Promise to pay</p>
          <p class="mt-1 font-medium text-slate-900"><%= @call_attempt.promise_to_pay_on.to_fs(:long) %></p>
        </div>
      <% end %>

      <% if @call_attempt.sentiment.present? %>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Sentiment</p>
          <p class="mt-1 font-medium text-slate-900"><%= @call_attempt.sentiment.humanize %></p>
        </div>
      <% end %>
    </div>
  </section>
<% elsif @call_attempt.pending? || @call_attempt.in_progress? %>
  <section class="mt-8 rounded-xl border border-blue-200 bg-blue-50 px-6 py-6">
    <h2 class="text-lg font-bold text-blue-950">Call in progress</h2>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-blue-800">DueCall is waiting for CALL-E to complete the conversation. The result will appear here when the terminal webhook arrives.</p>
  </section>
<% else %>
  <section class="mt-8 rounded-xl border border-red-200 bg-red-50 px-6 py-6">
    <h2 class="text-lg font-bold text-red-950">Call failed</h2>
    <p class="mt-2 text-sm text-red-800">The call could not be completed.</p>
    <% if @call_attempt.summary.present? %>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-red-900"><%= @call_attempt.summary %></p>
    <% end %>
  </section>
<% end %>

<section class="mt-8" aria-labelledby="call-details-heading">
  <h2 id="call-details-heading" class="text-lg font-bold tracking-tight text-slate-950">Call details</h2>
  <div class="mt-4 grid gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Invoice</p>
      <p class="mt-1"><%= link_to @invoice.number, @invoice, class: "font-semibold text-blue-600 hover:text-blue-500" %></p>
      <p class="mt-1 text-sm text-slate-600"><%= format_money(@invoice.amount_cents, @invoice.currency) %></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Customer</p>
      <p class="mt-1"><%= link_to @customer.name, @customer, class: "font-semibold text-blue-600 hover:text-blue-500" %></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Contact</p>
      <p class="mt-1"><%= link_to @contact.name, @contact, class: "font-semibold text-blue-600 hover:text-blue-500" %></p>
      <p class="mt-1 text-sm text-slate-600"><%= @contact.phone_number %></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Started</p>
      <p class="mt-1 text-sm text-slate-900"><%= @call_attempt.started_at&.to_fs(:long) || "—" %></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Completed</p>
      <p class="mt-1 text-sm text-slate-900"><%= @call_attempt.completed_at&.to_fs(:long) || "—" %></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Duration</p>
      <p class="mt-1 text-sm text-slate-900"><%= call_attempt_duration(@call_attempt) || "—" %></p>
    </div>
  </div>
</section>

<% if @call_attempt.transcript.present? %>
  <section class="mt-8" aria-labelledby="transcript-heading">
    <h2 id="transcript-heading" class="text-lg font-bold tracking-tight text-slate-950">Transcript</h2>
    <div class="mt-4 space-y-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <% transcript_turns(@call_attempt.transcript).each do |turn| %>
        <div class="rounded-lg px-4 py-3 <%= turn[:speaker] == "due-call" ? "bg-blue-50" : turn[:speaker] == "customer" ? "bg-slate-100" : "border border-slate-200 bg-white" %>">
          <p class="text-xs font-semibold uppercase tracking-wide <%= turn[:speaker] == "due-call" ? "text-blue-700" : "text-slate-500" %>"><%= turn[:label] %></p>
          <p class="mt-1 whitespace-pre-wrap text-sm leading-6 text-slate-800"><%= turn[:text] %></p>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
