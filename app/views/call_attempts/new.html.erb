<% content_for :title, "Review call · #{@invoice.number} · DueCall" %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← #{@invoice.number}", invoice_path(@invoice), class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>
  <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Review call</h1>
  <p class="mt-2 text-sm text-slate-500">Confirm the recipient and payment follow-up before placing a real call.</p>

  <section class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="grid gap-6 border-b border-slate-200 p-6 sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Recipient</p>
        <h2 class="mt-2 text-xl font-bold text-slate-950"><%= @contact.name %></h2>
        <% if @contact.role.present? %>
          <p class="mt-1 text-sm text-slate-600"><%= @contact.role %></p>
        <% end %>
        <p class="mt-2 font-medium text-slate-900"><%= @contact.phone_number %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Invoice</p>
        <h2 class="mt-2 text-xl font-bold text-slate-950"><%= @invoice.customer.name %></h2>
        <p class="mt-1 text-sm font-semibold text-blue-600"><%= @invoice.number %></p>
        <p class="mt-2 font-medium text-slate-900"><%= format_money(@invoice.amount_cents, @invoice.currency) %></p>
        <p class="mt-1 text-sm text-red-700"><%= pluralize((Date.current - @invoice.due_on).to_i, "day") %> overdue</p>
      </div>
    </div>

    <div class="p-6">
      <h2 class="text-lg font-bold text-slate-950">DueCall will:</h2>
      <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
        <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span><span>Identify itself as an AI assistant.</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span><span>Confirm the invoice and current payment status.</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span><span>Ask what is blocking payment.</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span><span>Capture a promised payment date if voluntarily provided.</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span><span>Identify missing invoice or PO information and disputes.</span></li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span><span>Escalate ambiguous or sensitive situations for human follow-up.</span></li>
      </ul>

      <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-600">
        DueCall will not request card or bank credentials, threaten the recipient, make legal claims, or make commitments on your behalf.
      </div>
    </div>
  </section>

  <section class="mt-6 rounded-xl border border-amber-200 bg-amber-50 px-5 py-5">
    <p class="text-sm font-medium leading-6 text-amber-950">This will place a real AI-assisted phone call to <%= @contact.name %> at <%= @contact.phone_number %>.</p>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <%= link_to "Cancel", invoice_path(@invoice), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
      <%= button_to "Call #{@contact.name.split.first}", invoice_call_attempts_path(@invoice), params: { contact_id: @contact.id }, class: "rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
    </div>
  </section>
</div>
