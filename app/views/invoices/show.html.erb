<% content_for :title, "#{@invoice.number} · DueCall" %>

<% if notice = flash[:notice] %>
  <p class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= notice %></p>
<% end %>

<% if alert = flash[:alert] %>
  <p class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= alert %></p>
<% end %>

<div class="flex items-start justify-between gap-4">
  <div>
    <%= link_to "← #{@customer.name}", customer_path(@customer), class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950"><%= @invoice.number %></h1>
    <p class="mt-1 text-sm text-slate-500"><%= @customer.name %></p>
  </div>
  <%= link_to "Edit", edit_invoice_path(@invoice), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
</div>

<dl class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="grid gap-1 border-b border-slate-200 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Amount</dt>
    <dd class="font-semibold text-slate-900 sm:col-span-2"><%= format_money(@invoice.amount_cents, @invoice.currency) %></dd>
  </div>
  <div class="grid gap-1 border-b border-slate-200 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Issue date</dt>
    <dd class="text-sm text-slate-900 sm:col-span-2"><%= @invoice.issued_on&.to_fs(:long) || "Not provided" %></dd>
  </div>
  <div class="grid gap-1 border-b border-slate-200 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Due date</dt>
    <dd class="text-sm text-slate-900 sm:col-span-2"><%= @invoice.due_on.to_fs(:long) %></dd>
  </div>
  <div class="grid gap-1 border-b border-slate-200 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Payment status</dt>
    <dd class="text-sm text-slate-900 sm:col-span-2"><%= @invoice.status.humanize %></dd>
  </div>
  <div class="grid gap-1 <%= "border-b border-slate-200" if @invoice.external_id.present? %> px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Overdue</dt>
    <dd class="text-sm font-medium sm:col-span-2 <%= @invoice.overdue? ? "text-red-700" : "text-slate-900" %>"><%= @invoice.overdue? ? "Yes" : "No" %></dd>
  </div>
  <% if @invoice.external_id.present? %>
    <div class="grid gap-1 px-5 py-4 sm:grid-cols-3 sm:gap-4">
      <dt class="text-sm font-medium text-slate-500">External ID</dt>
      <dd class="text-sm text-slate-900 sm:col-span-2"><%= @invoice.external_id %></dd>
    </div>
  <% end %>
</dl>

<% if @invoice.overdue? %>
  <section class="mt-10 rounded-xl border border-red-200 bg-red-50/60 p-5">
    <h2 class="text-lg font-bold text-slate-950">Follow up by phone</h2>
    <p class="mt-1 text-sm text-slate-600">Review a focused AI-assisted payment follow-up before placing the call.</p>

    <% if @active_call_attempt %>
      <div class="mt-5 rounded-lg border border-blue-200 bg-blue-50 px-4 py-4">
        <p class="font-semibold text-blue-950">Call in progress</p>
        <p class="mt-1 text-sm text-blue-800">A follow-up call is already pending or underway for this invoice.</p>
        <%= link_to "View active call", @active_call_attempt, class: "mt-3 inline-block text-sm font-semibold text-blue-700 hover:text-blue-600" %>
      </div>
    <% elsif @contacts.any? %>
      <%= form_with url: new_invoice_call_attempt_path(@invoice), method: :get, class: "mt-5 space-y-4" do |form| %>
        <div>
          <%= form.label :contact_id, "Contact", class: "block text-sm font-medium text-slate-700" %>
          <%= form.select :contact_id, @contacts.map { |contact| [ "#{contact.name} — #{contact.phone_number}", contact.id ] }, {}, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
          <p class="mt-1.5 text-xs text-slate-500">The selected contact's phone number is shown above.</p>
        </div>
        <%= form.submit "Review call", class: "cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
      <% end %>
    <% else %>
      <p class="mt-4 text-sm text-slate-600">Add a contact with a valid phone number before starting a call.</p>
      <%= link_to "Add contact", new_customer_contact_path(@customer), class: "mt-4 inline-block text-sm font-semibold text-blue-600 hover:text-blue-500" %>
    <% end %>
  </section>
<% end %>

<section class="mt-10">
  <div>
    <h2 class="text-xl font-bold tracking-tight text-slate-950">Call history</h2>
    <p class="mt-1 text-sm text-slate-500">Follow-up calls made for this invoice.</p>
  </div>

  <% if @call_attempts.any? %>
    <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <ul class="divide-y divide-slate-200">
        <% @call_attempts.each do |call_attempt| %>
          <li>
            <%= link_to call_attempt, class: "block px-5 py-4 hover:bg-slate-50" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-semibold text-slate-900"><%= call_attempt.contact.name %></p>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600"><%= call_attempt.status.humanize %></span>
                    <% if call_attempt.outcome.present? %>
                      <span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700"><%= call_attempt.outcome.humanize %></span>
                    <% end %>
                  </div>
                  <p class="mt-1 text-sm text-slate-500"><%= call_attempt.contact.phone_number %></p>
                  <% if call_attempt.promise_to_pay_on.present? %>
                    <p class="mt-2 text-sm font-medium text-emerald-700">Promised payment by <%= call_attempt.promise_to_pay_on.to_fs(:long) %></p>
                  <% end %>
                  <% if call_attempt.summary.present? %>
                    <p class="mt-2 line-clamp-2 text-sm text-slate-600"><%= call_attempt.summary %></p>
                  <% end %>
                  <p class="mt-2 text-xs text-slate-400"><%= (call_attempt.started_at || call_attempt.created_at).to_fs(:long) %></p>
                </div>
                <span aria-hidden="true" class="text-slate-400">&rarr;</span>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
      <h3 class="font-semibold text-slate-900">No calls yet</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">Calls will appear here after DueCall follows up with the customer.</p>
    </div>
  <% end %>
</section>

<div class="mt-10 border-t border-slate-200 pt-6">
  <%= button_to "Delete invoice", @invoice, method: :delete, class: "text-sm font-medium text-red-600 hover:text-red-500", form: { data: { turbo_confirm: "Delete this invoice?" } } %>
</div>
