<%= form_with model: (invoice.persisted? ? invoice : [ customer, invoice ]), class: "space-y-6" do |form| %>
  <% if invoice.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% invoice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :number, "Invoice number", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :number, required: true, autofocus: true, placeholder: "INV-001", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :amount, "Amount", class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :amount, required: true, min: "0.01", step: "0.01", placeholder: "125.00", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
    </div>
    <div>
      <%= form.label :currency, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :currency, required: true, placeholder: "USD", class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 uppercase shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :issued_on, "Issue date", class: "block text-sm font-medium text-slate-700" %>
      <%= form.date_field :issued_on, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
      <p class="mt-1.5 text-xs text-slate-500">Optional</p>
    </div>
    <div>
      <%= form.label :due_on, "Due date", class: "block text-sm font-medium text-slate-700" %>
      <%= form.date_field :due_on, required: true, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
    </div>
  </div>

  <div>
    <%= form.label :status, class: "block text-sm font-medium text-slate-700" %>
    <%= form.select :status, Invoice.statuses.keys.map { |status| [ status.humanize, status ] }, {}, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
  </div>

  <div>
    <%= form.label :external_id, "External ID", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :external_id, class: "mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" %>
    <p class="mt-1.5 text-xs text-slate-500">Optional reference from another system</p>
  </div>

  <div class="flex items-center gap-3 border-t border-slate-200 pt-6">
    <%= form.submit class: "cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
    <%= link_to "Cancel", invoice.persisted? ? invoice_path(invoice) : customer_path(customer), class: "rounded-lg px-4 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-950" %>
  </div>
<% end %>
