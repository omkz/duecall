<% content_for :title, "#{@customer.name} · DueCall" %>

<% if notice = flash[:notice] %>
  <p class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700"><%= notice %></p>
<% end %>

<div class="flex items-start justify-between gap-4">
  <div>
    <%= link_to "← Customers", customers_path, class: "text-sm font-medium text-slate-500 hover:text-slate-900" %>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950"><%= @customer.name %></h1>
  </div>
  <%= link_to "Edit", edit_customer_path(@customer), class: "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50" %>
</div>

<dl class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="grid gap-1 border-b border-slate-200 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">Email</dt>
    <dd class="text-sm text-slate-900 sm:col-span-2"><%= @customer.email.presence || "Not provided" %></dd>
  </div>
  <div class="grid gap-1 px-5 py-4 sm:grid-cols-3 sm:gap-4">
    <dt class="text-sm font-medium text-slate-500">External ID</dt>
    <dd class="text-sm text-slate-900 sm:col-span-2"><%= @customer.external_id.presence || "Not provided" %></dd>
  </div>
</dl>

<section class="mt-10">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight text-slate-950">Invoices</h2>
      <p class="mt-1 text-sm text-slate-500">Amounts due from this customer.</p>
    </div>
    <%= link_to "Add invoice", new_customer_invoice_path(@customer), class: "shrink-0 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>

  <% if @invoices.any? %>
    <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <ul class="divide-y divide-slate-200">
        <% @invoices.each do |invoice| %>
          <li class="<%= "bg-red-50/70" if invoice.overdue? %>">
            <%= link_to invoice, class: "flex items-center justify-between gap-4 px-5 py-4 hover:bg-slate-50/80" do %>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="font-semibold text-slate-900"><%= invoice.number %></p>
                  <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= invoice.overdue? ? "bg-red-100 text-red-700" : "bg-slate-100 text-slate-600" %>">
                    <%= invoice.overdue? ? "Overdue" : invoice.status.humanize %>
                  </span>
                </div>
                <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-slate-600">
                  <span><%= format_money(invoice.amount_cents, invoice.currency) %></span>
                  <span>Due <%= invoice.due_on.to_fs(:long) %></span>
                </div>
              </div>
              <span aria-hidden="true" class="text-slate-400">&rarr;</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
      <h3 class="font-semibold text-slate-900">No invoices yet</h3>
      <p class="mx-auto mt-2 max-w-sm text-sm text-slate-500">Add an invoice to track what this customer owes.</p>
      <%= link_to "Add the first invoice", new_customer_invoice_path(@customer), class: "mt-4 inline-block text-sm font-semibold text-blue-600 hover:text-blue-500" %>
    </div>
  <% end %>
</section>

<section class="mt-10">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight text-slate-950">Contacts</h2>
      <p class="mt-1 text-sm text-slate-500">People you can reach at this customer.</p>
    </div>
    <%= link_to "Add contact", new_customer_contact_path(@customer), class: "shrink-0 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>

  <% if @contacts.any? %>
    <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <ul class="divide-y divide-slate-200">
        <% @contacts.each do |contact| %>
          <li>
            <%= link_to contact, class: "block px-5 py-4 hover:bg-slate-50" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                    <p class="font-semibold text-slate-900"><%= contact.name %></p>
                    <% if contact.role.present? %>
                      <p class="text-sm text-slate-500"><%= contact.role %></p>
                    <% end %>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-slate-600">
                    <span><%= contact.phone_number %></span>
                    <span><%= contact.email.presence || "No email added" %></span>
                  </div>
                </div>
                <span aria-hidden="true" class="text-slate-400">&rarr;</span>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
      <h3 class="font-semibold text-slate-900">No contacts yet</h3>
      <p class="mx-auto mt-2 max-w-sm text-sm text-slate-500">Add a contact person so you know who to call.</p>
      <%= link_to "Add the first contact", new_customer_contact_path(@customer), class: "mt-4 inline-block text-sm font-semibold text-blue-600 hover:text-blue-500" %>
    </div>
  <% end %>
</section>

<div class="mt-10 border-t border-slate-200 pt-6">
  <%= button_to "Delete customer", @customer, method: :delete, class: "text-sm font-medium text-red-600 hover:text-red-500", form: { data: { turbo_confirm: "Delete this customer?" } } %>
</div>
